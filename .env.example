# Copy to .env and fill in. NEVER commit .env.
# Without a key the app still runs: every AI text falls back to a template.

# none | openai (also any OpenAI-compatible endpoint, e.g. JAIF) | azure | anthropic
# JAIF (Build Days): LLM_PROVIDER=openai, LLM_BASE_URL=https://hip-gw.hessian.ai/v1,
# key = top of the JAIF Model Handbook (HTML attached to the 'starter kit' message in Discord; open it in a browser)
# model: LLM_MODEL=hIP_1.0-Mistral/Mistral-Medium-3.5-128B (tested: accurate, 5-7 s, good German)
LLM_PROVIDER=none
LLM_API_KEY=
# Leave empty for the provider default (gpt-4o-mini / claude-sonnet-5-5)
LLM_MODEL=
# OpenAI-compatible endpoint (JAIF, Mistral, local model, ...) or Azure endpoint
LLM_BASE_URL=
AZURE_API_VERSION=2024-06-01
# Answer cache for the live demo (data/llm_cache.json); false = always ask the model
LLM_CACHE=true

# Optional path overrides
# IIH_DATA_DIR=./data
# IIH_RAW_DIR=C:/path/to/Futury MDS Data Excerpt
