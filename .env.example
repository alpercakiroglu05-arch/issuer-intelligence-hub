# Copy to .env and fill in. NEVER commit .env.

# mock = no key needed (offline demo) | anthropic | openai (also any OpenAI-compatible endpoint)
LLM_PROVIDER=mock
# Leave empty for the provider default (see core/llm.py)
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: OpenAI-compatible endpoint (Mistral, local model, organiser-provided endpoint, ...)
OPENAI_BASE_URL=

# Cache answers on disk so the live demo survives API or Wi-Fi outages
LLM_CACHE=true
